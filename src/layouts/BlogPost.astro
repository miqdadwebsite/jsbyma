---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import LikeButton from "../components/LikeButton.astro";

type Props = CollectionEntry<"blog">["data"];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
} = Astro.props;

const likeId = title.replace(/\s+/g, "-").toLowerCase();

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline: title,
	description: description,
	datePublished: pubDate?.toISOString(),
	dateModified: updatedDate ? updatedDate.toISOString() : pubDate?.toISOString(),
	author: {
		"@type": "Person",
		name: "Just Sharing by MA",
		url: "https://jsbyma.pages.dev",
	},
	publisher: {
		"@type": "Organization",
		name: "Just Sharing by MA",
		url: "https://jsbyma.pages.dev",
	},
	mainEntityOfPage: {
		"@type": "WebPage",
		"@id": canonicalURL.toString(),
	},
	...(heroImage && {
		image: new URL(heroImage.src, Astro.site).toString(),
	}),
};
---

<html lang="id" data-theme="light">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={heroImage}
			type="article"
			pubDate={pubDate}
		/>
		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>

	<body class="medium-body">

		<Header />

		<main>
			<article id="article-content">
				<!-- Article Header -->
				<header class="article-header">
					{category && (
						<a href="/blog" class="category-tag">{category}</a>
					)}
					<h1 class="article-title">{title}</h1>
					{description && (
						<p class="article-subtitle">{description}</p>
					)}

					<!-- Author row -->
					<div class="author-row">
						<div class="author-avatar" aria-hidden="true">MA</div>
						<div class="author-info">
							<span class="author-name">Just Sharing by MA</span>
							<div class="article-meta">
								<FormattedDate date={pubDate} />

								{updatedDate && (
									<>
										<span class="meta-dot">·</span>
										<span class="updated-label">
											Updated <FormattedDate date={updatedDate} />
										</span>
									</>
								)}
							</div>
						</div>
						<!-- Like button in header -->
						<div class="header-like">
							<LikeButton id={likeId} variant="header" />
						</div>
					</div>
				</header>

				<!-- Hero Image -->
				{heroImage && (
					<div class="hero-wrapper">
						<Image
							width={1200}
							height={600}
							src={heroImage}
							alt={title}
							class="hero-image"
						/>
					</div>
				)}

				<!-- Article Body -->
				<div class="article-body prose">
					<slot />
				</div>

				<!-- Footer reaction -->
				<div class="article-footer">
					<div class="footer-divider" />
<div class="footer-reaction">
					<LikeButton id={likeId} />
					<a href="/blog" class="back-link">
						← Back to all articles
					</a>
				</div>
				</div>
			</article>
		</main>

		<Footer />



		<style>
			/* ─── Base ─────────────────────────────────────── */
			.medium-body {
				background: #fff;
				color: #242424;
				font-family: 'Poppins', sans-serif;
				min-height: 100vh;
			}

			/* ─── Article Header ────────────────────────────── */
			.article-header {
				max-width: 680px;
				margin: 48px auto 0;
				padding: 0 24px;
			}

			.category-tag {
				display: inline-block;
				font-size: 13px;
				font-weight: 600;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: #1a8917;
				text-decoration: none;
				margin-bottom: 16px;
			}
			.category-tag:hover {
				text-decoration: underline;
			}

			.article-title {
				font-size: clamp(28px, 5vw, 42px);
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: -0.3px;
				color: #242424;
				margin: 0 0 16px;
			}

			.article-subtitle {
				font-size: 20px;
				font-weight: 400;
				color: #6b6b6b;
				line-height: 1.5;
				margin: 0 0 28px;
			}

			/* ─── Author Row ────────────────────────────────── */
			.author-row {
				display: flex;
				align-items: center;
				gap: 12px;
				padding: 16px 0;
				border-top: 1px solid #f2f2f2;
				border-bottom: 1px solid #f2f2f2;
				margin-bottom: 0;
			}

			.author-avatar {
				width: 44px;
				height: 44px;
				border-radius: 50%;
				background: linear-gradient(135deg, #1a8917, #0f6b0d);
				color: #fff;
				font-size: 14px;
				font-weight: 700;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
				letter-spacing: 0.5px;
			}

			.author-info {
				flex: 1;
				min-width: 0;
			}

			.author-name {
				display: block;
				font-size: 14px;
				font-weight: 600;
				color: #242424;
				line-height: 1.3;
			}

			.article-meta {
				font-size: 13px;
				color: #6b6b6b;
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 4px;
				margin-top: 2px;
			}

			.meta-dot {
				color: #6b6b6b;
				font-size: 10px;
			}

			.updated-label {
				font-style: italic;
			}

			.header-like {
				margin-left: auto;
				flex-shrink: 0;
			}

			/* ─── Hero Image ────────────────────────────────── */
			.hero-wrapper {
				max-width: 900px;
				margin: 40px auto;
				padding: 0 24px;
			}

			.hero-image {
				width: 100%;
				height: auto;
				max-height: 520px;
				object-fit: cover;
				border-radius: 4px;
				display: block;
			}

			/* ─── Article Body (Prose) ──────────────────────── */
			.article-body {
				max-width: 680px;
				margin: 0 auto;
				padding: 40px 24px 64px;

				/* Medium-style typography */
				font-size: 20px;
				line-height: 1.8;
				color: #242424;
				font-family: 'Poppins', sans-serif;
			}

			/* Headings */
			.article-body :global(h1),
			.article-body :global(h2),
			.article-body :global(h3),
			.article-body :global(h4) {
				font-family: 'Poppins', sans-serif;
				color: #242424;
				font-weight: 700;
				letter-spacing: -0.2px;
				margin-top: 2em;
				margin-bottom: 0.5em;
				line-height: 1.25;
			}

			.article-body :global(h2) { font-size: 28px; }
			.article-body :global(h3) { font-size: 22px; }
			.article-body :global(h4) { font-size: 18px; }

			/* Paragraphs */
			.article-body :global(p) {
				margin-bottom: 2em;
				font-size: 20px;
				line-height: 1.8;
				color: #242424;
			}

			/* Links */
			.article-body :global(a) {
				color: #242424;
				text-decoration: underline;
				text-underline-offset: 3px;
			}
			.article-body :global(a:hover) {
				color: #1a8917;
			}

			/* Blockquote */
			.article-body :global(blockquote) {
				margin: 2em 0;
				padding: 0 0 0 28px;
				border-left: 4px solid #242424;
				font-size: 22px;
				font-style: italic;
				color: #6b6b6b;
				line-height: 1.6;
			}

			/* Code inline */
			.article-body :global(code:not(pre code)) {
				background: #f2f2f2;
				color: #c7254e;
				padding: 2px 6px;
				border-radius: 4px;
				font-size: 0.85em;
				font-family: 'Courier New', monospace;
			}

			/* Code blocks */
			.article-body :global(pre) {
				background: #1e1e1e;
				color: #d4d4d4;
				padding: 24px;
				border-radius: 8px;
				overflow-x: auto;
				font-size: 15px;
				line-height: 1.6;
				margin: 2em 0;
			}

			/* Images in content */
			.article-body :global(img) {
				max-width: 100%;
				border-radius: 4px;
				margin: 2em 0;
			}

			/* HR */
			.article-body :global(hr) {
				border: 0;
				border-top: 1px solid #e5e5e5;
				margin: 48px 0;
			}

			/* Lists */
			.article-body :global(ul),
			.article-body :global(ol) {
				padding-left: 28px;
				margin: 0 0 2em;
			}
			.article-body :global(li) {
				margin-bottom: 0.5em;
				font-size: 20px;
				line-height: 1.7;
			}

			/* Strong */
			.article-body :global(strong) {
				font-weight: 700;
				color: #242424;
			}

			/* ─── Article Footer ────────────────────────────── */
			.article-footer {
				max-width: 680px;
				margin: 0 auto;
				padding: 0 24px 80px;
			}

			.footer-divider {
				height: 1px;
				background: #f2f2f2;
				margin-bottom: 40px;
			}

			.footer-reaction {
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 16px;
			}

			.back-link {
				font-size: 14px;
				font-weight: 500;
				color: #6b6b6b;
				text-decoration: none;
				transition: color 0.2s;
			}
			.back-link:hover {
				color: #242424;
			}

			/* ─── Responsive ────────────────────────────────── */
			@media (max-width: 640px) {
				.article-header {
					margin-top: 28px;
				}
				.article-title {
					font-size: 26px;
				}
				.article-subtitle {
					font-size: 17px;
				}
				.article-body {
					font-size: 18px;
					padding: 32px 20px 48px;
				}
				.article-body :global(p),
				.article-body :global(li) {
					font-size: 18px;
				}
				.article-body :global(blockquote) {
					font-size: 19px;
				}
				.hero-wrapper {
					padding: 0;
					margin: 28px 0;
				}
				.hero-image {
					border-radius: 0;
				}
				.article-body :global(h2) { font-size: 22px; }
				.article-body :global(h3) { font-size: 19px; }
			}
		</style>
	</body>
</html>
