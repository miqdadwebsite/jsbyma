---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"] & {
	lyketType?: "like" | "clap" | "updown" | "rate";
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	lyketType = "like",
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main class="w-full max-w-full m-0">
			<article>
				<div class="w-full">
					{
						heroImage && (
							<Image
								width={1020}
								height={510}
								src={heroImage}
								alt=""
								class="block mx-auto rounded-xl shadow-md md:mt-12"
							/>
						)
					}
				</div>
				<div
					class="prose prose-xl w-[720px] max-w-[calc(100%-2em)] mx-auto p-4 text-[rgb(34,41,57)]"
				>
					<div class="mb-4 py-4 text-center leading-none">
						<div class="mb-2 text-[rgb(96,115,159)]">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="italic">
										Last updated on{" "}
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1 class="text-3xl md:text-5xl mb-4">{title}</h1>
						<hr />
					</div>
					<slot />

					<!-- Lyket Widget Button -->
					<div
						class="lyket-container mt-12 pt-8 border-t border-[rgb(229,233,240)] flex justify-center"
					>
						<div
							data-lyket-type={lyketType}
							data-lyket-id={title
								.replace(/\s+/g, "-")
								.toLowerCase()}
							data-lyket-namespace="blog-post"
						>
						</div>
					</div>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
