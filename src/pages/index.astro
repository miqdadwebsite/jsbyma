---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

// Fetch the 3 most recent blog posts
const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: "https://jsbyma.pages.dev",
	potentialAction: {
		"@type": "SearchAction",
		target: {
			"@type": "EntryPoint",
			urlTemplate: "https://jsbyma.pages.dev/search?q={search_term_string}",
		},
		"query-input": "required name=search_term_string",
	},
	publisher: {
		"@type": "Person",
		name: "Just Sharing by MA",
		url: "https://jsbyma.pages.dev",
	},
};
---

<!doctype html>
<html lang="id" data-theme="light">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body class="bg-base-200">
		<Header />
		<main class="w-full max-w-[760px] mx-auto p-4">
			<!-- Hero Section -->
			<div class="hero bg-base-100 rounded-box shadow-xl mb-12 mt-4 p-8">
				<div class="hero-content text-center">
					<div>
						<h1 class="text-2xl md:text-5xl font-bold">
							Welcome to My Blog's 👋
						</h1>
					</div>
				</div>
			</div>

			<!-- Latest Posts Section -->
			<section class="mb-24">
				<h2 class="text-3xl font-bold text-center mb-8">
					Latest Articles
				</h2>
				<div class="divide-y divide-base-300">
					{
						posts.map((post, index) => (
							<a
								href={`/blog/${post.id}/`}
								class="post-list-item flex items-start gap-6 py-8 group no-underline"
								data-category={post.data.category}
								data-date={post.data.pubDate.valueOf()}
								data-post-card
							>
								<!-- Left: Content -->
								<div class="flex-1 min-w-0">
									<!-- Author / Meta row -->
									<div class="flex items-center gap-2 mb-3">
										<span class="badge badge-ghost bg-base-300 badge-sm font-semibold">
											{post.data.category}
										</span>
										{index === 0 && (
											<span class="badge badge-ghost bg-base-300 badge-sm font-semibold">
												NEW
											</span>
										)}
									</div>

									<!-- Title -->
									<h2 class="post-title text-xl font-bold leading-snug mb-2 transition-colors duration-200">
										{post.data.title}
									</h2>

									<!-- Description -->
									<p class="text-sm opacity-60 leading-relaxed line-clamp-2 mb-4">
										{post.data.description ||
											"Read more about this topic in the full article."}
									</p>

									<!-- Footer meta -->
									<div
										class="flex items-center gap-4 text-xs opacity-50"
										data-like-id={post.data.title.replace(/\s+/g, "-").toLowerCase()}
									>
										<span>
											<FormattedDate date={post.data.pubDate} />
										</span>

										<span class="w-1 h-1 rounded-full bg-current inline-block" />
										<span class="like-count flex items-center gap-1">
											<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
											<span class="like-num">—</span>
										</span>
									</div>
								</div>

								<!-- Right: Thumbnail -->
								<div class="shrink-0 w-28 h-20 md:w-36 md:h-24 rounded-lg overflow-hidden bg-base-300">
									{post.data.heroImage ? (
										<Image
											width={288}
											height={192}
											src={post.data.heroImage}
											alt={post.data.title}
											class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
										/>
									) : (
										<div class="w-full h-full placeholder-thumb flex items-center justify-center text-2xl opacity-20">
											📄
										</div>
									)}
								</div>
							</a>
						))
					}
				</div>
				<div class="flex justify-center mt-12">
					<a href="/blog/" class="btn btn-lg font-medium"
						>Explore All Posts</a
					>
				</div>
			</section>
		</main>
		<Footer />
		<script>
			import { formatLikes, loadLikes } from "../lib/likes";

			async function loadLikeCounts() {
				const metaRows = document.querySelectorAll<HTMLElement>("[data-like-id]");
				const ids = Array.from(metaRows).map((el) => el.dataset.likeId!);
				if (!ids.length) return;

				try {
					const likes = await loadLikes(ids);
					likes.forEach((state, id) => {
						const metaRow = Array.from(metaRows).find(
							(el) => el.dataset.likeId === id,
						);
						if (!metaRow) return;
						const numEl = metaRow.querySelector(".like-num");
						if (numEl) numEl.textContent = formatLikes(state.likes);
					});
				} catch {
					// silently ignore network errors
				}
			}

			// Load like counts when DOM is ready
			window.addEventListener('DOMContentLoaded', loadLikeCounts);
		</script>
		<style>
			/* Post title hover color */
			.post-list-item:hover .post-title {
				color: oklch(var(--p));
			}

			/* Placeholder thumbnail bg */
			.placeholder-thumb {
				background: linear-gradient(135deg, oklch(var(--b3)), oklch(var(--b2)));
			}
		</style>
	</body>
</html>
