---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Get unique categories
const categories = ["All", ...new Set(posts.map((p) => p.data.category))];

// Serialize posts for client-side filtering
const postsData = posts.map((post) => ({
	id: post.id,
	title: post.data.title,
	description:
		post.data.description ||
		"Read more about this topic in the full article.",
	category: post.data.category,
	pubDate: post.data.pubDate.toISOString(),
	heroImage: post.data.heroImage ? true : false,
}));
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-base-200">
		<Header />
		<main class="w-full max-w-[760px] mx-auto px-4 py-8">
			<section class="mb-12 mt-4">
				<h1 class="text-3xl font-bold mb-2">All Articles</h1>
				<p class="text-sm opacity-50 mb-6" id="results-count">
					Showing {posts.length} articles
				</p>

				<!-- Filters and Sort -->
				<div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
					<!-- Category Filter Tabs -->
					<div
						class="flex flex-wrap gap-2"
						id="category-filters"
					>
						{
							categories.map((cat) => (
								<button
									class:list={[
										"category-btn text-sm px-4 py-1.5 rounded-full border transition-all font-medium",
										cat === "All"
											? "active-cat"
											: "inactive-cat",
									]}
									data-category={cat}
								>
									{cat}
									{cat !== "All" && (
										<span class="ml-1 text-xs opacity-60">
											{
												posts.filter(
													(p) => p.data.category === cat,
												).length
											}
										</span>
									)}
								</button>
							))
						}
					</div>

					<!-- Sort Dropdown -->
					<div class="dropdown dropdown-end">
						<div tabindex="0" role="button" class="btn btn-sm m-1">
							Sort by: <span id="current-sort">Newest</span>
						</div>
						<ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-[1] w-40 p-2 shadow border border-base-300">
							<li><button class="sort-option" data-value="newest">Newest</button></li>
							<li><button class="sort-option" data-value="oldest">Oldest</button></li>
							<li><button class="sort-option" data-value="popular">Popular</button></li>
						</ul>
					</div>
				</div>

				<!-- Post List (Medium-style) -->
				<div id="posts-list" class="divide-y divide-base-300">
					{
						posts.map((post, index) => (
							<a
								href={`/blog/${post.id}/`}
								class="post-list-item flex items-start gap-6 py-8 group no-underline"
								data-category={post.data.category}
								data-date={post.data.pubDate.valueOf()}
								data-post-card
								style={index >= 5 ? "display: none;" : ""}
							>
								<!-- Left: Content -->
								<div class="flex-1 min-w-0">
									<!-- Author / Meta row -->
									<div class="flex items-center gap-2 mb-3">
										<span class="badge badge-ghost bg-base-300 badge-sm font-semibold">
											{post.data.category}
										</span>
										{index === 0 && (
											<span class="badge badge-ghost bg-base-300 badge-sm font-semibold">
												NEW
											</span>
										)}
									</div>

									<!-- Title -->
									<h2 class="post-title text-xl font-bold leading-snug mb-2 transition-colors duration-200">
										{post.data.title}
									</h2>

									<!-- Description -->
									<p class="text-sm opacity-60 leading-relaxed line-clamp-2 mb-4">
										{post.data.description ||
											"Read more about this topic in the full article."}
									</p>

									<!-- Footer meta -->
									<div
										class="flex items-center gap-4 text-xs opacity-50"
										data-like-id={post.data.title.replace(/\s+/g, "-").toLowerCase()}
									>
										<span>
											<FormattedDate date={post.data.pubDate} />
										</span>

										<span class="w-1 h-1 rounded-full bg-current inline-block" />
										<span class="like-count flex items-center gap-1">
											<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
											<span class="like-num">—</span>
										</span>
									</div>
								</div>

								<!-- Right: Thumbnail -->
								<div class="shrink-0 w-28 h-20 md:w-36 md:h-24 rounded-lg overflow-hidden bg-base-300">
									{post.data.heroImage ? (
										<Image
											width={288}
											height={192}
											src={post.data.heroImage}
											alt={post.data.title}
											class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
										/>
									) : (
										<div class="w-full h-full placeholder-thumb flex items-center justify-center text-2xl opacity-20">
											📄
										</div>
									)}
								</div>
							</a>
						))
					}
				</div>

				<!-- Load More Button -->
				<div class="mt-12 text-center">
					<button id="load-more-btn" class="btn btn-neutral px-12 rounded-full" style="display: none;">
						Load More
					</button>
				</div>

				<!-- Empty state -->
				<div id="empty-state" class="hidden text-center py-20">
					<div class="text-6xl mb-4">🔍</div>
					<p class="text-lg font-semibold">No articles found</p>
					<p class="opacity-60 text-sm mt-1">
						Try selecting a different category.
					</p>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			import { formatLikes, loadLikes } from "../../lib/likes";

			const cards = document.querySelectorAll<HTMLElement>("[data-post-card]");
			const list = document.getElementById("posts-list")!;
			const sortOptions = document.querySelectorAll<HTMLButtonElement>(".sort-option");
			const currentSortLabel = document.getElementById("current-sort")!;
			const filterBtns = document.querySelectorAll<HTMLButtonElement>("#category-filters .category-btn");
			const resultsCount = document.getElementById("results-count")!;
			const emptyState = document.getElementById("empty-state")!;
			const loadMoreBtn = document.getElementById("load-more-btn")!;

			let activeSort = "newest";
			let activeCategory = "All";
			let pageSize = 5;
			let currentPage = 1;

			function updateView() {
				let visibleCount = 0;
				let matchCount = 0;
				
				const cardsArray = Array.from(cards);
				
				cardsArray.sort((a, b) => {
					if (activeSort === "newest") {
						return Number(b.dataset.date) - Number(a.dataset.date);
					} else if (activeSort === "oldest") {
						return Number(a.dataset.date) - Number(b.dataset.date);
					} else if (activeSort === "popular") {
						const likesA = Number(a.dataset.likes || 0);
						const likesB = Number(b.dataset.likes || 0);
						return likesB - likesA;
					}
					return 0;
				});

				cardsArray.forEach(card => list.appendChild(card));

				cardsArray.forEach((card) => {
					const cardCategory = card.dataset.category;
					const matchesCategory = activeCategory === "All" || cardCategory === activeCategory;
					
					if (matchesCategory) {
						matchCount++;
						if (visibleCount < currentPage * pageSize) {
							if (card.style.display === "none") {
								card.style.display = "";
								card.style.animation = "none";
								void card.offsetWidth; // trigger reflow
								card.style.animation = "fadeIn 0.25s ease forwards";
							}
							visibleCount++;
						} else {
							card.style.display = "none";
						}
					} else {
						card.style.display = "none";
					}
				});

				resultsCount.textContent = activeCategory === "All" 
					? `Showing ${visibleCount} of ${matchCount} articles` 
					: `Showing ${visibleCount} of ${matchCount} article${matchCount !== 1 ? "s" : ""} in "${activeCategory}"`;

				if (matchCount === 0) {
					list.style.display = "none";
					emptyState.classList.remove("hidden");
				} else {
					list.style.display = "";
					emptyState.classList.add("hidden");
				}

				if (visibleCount < matchCount) {
					loadMoreBtn.style.display = "";
				} else {
					loadMoreBtn.style.display = "none";
				}
			}

			sortOptions.forEach((btn) => {
				btn.addEventListener("click", () => {
					activeSort = btn.dataset.value!;
					currentSortLabel.textContent = btn.textContent;
					currentPage = 1;
					updateView();
					// Close dropdown
					(document.activeElement as HTMLElement)?.blur();
				});
			});

			filterBtns.forEach((btn) => {
				btn.addEventListener("click", () => {
					filterBtns.forEach((b) => {
						b.classList.remove("active-cat");
						b.classList.add("inactive-cat");
					});
					btn.classList.add("active-cat");
					btn.classList.remove("inactive-cat");

					activeCategory = btn.dataset.category!;
					currentPage = 1;
					updateView();
				});
			});

			loadMoreBtn.addEventListener("click", () => {
				currentPage++;
				updateView();
			});

			// Initialize view
			updateView();

			// ─── Fetch & render like counts ─────────────────────────────
			async function loadLikeCounts() {
				const metaRows = document.querySelectorAll<HTMLElement>("[data-like-id]");
				const ids = Array.from(metaRows).map((el) => el.dataset.likeId!);
				if (!ids.length) return;

				try {
					const likes = await loadLikes(ids);
					likes.forEach((state, id) => {
						const metaRow = Array.from(metaRows).find(
							(el) => el.dataset.likeId === id,
						);
						if (!metaRow) return;

						const numEl = metaRow.querySelector(".like-num");
						if (numEl) numEl.textContent = formatLikes(state.likes);

						const card = metaRow.closest("[data-post-card]") as HTMLElement;
						if (card) {
							card.dataset.likes = String(state.likes);
						}
					});
				} catch {
					// silently ignore network errors
				}

				if (activeSort === "popular") {
					updateView();
				}
			}

			loadLikeCounts();
		</script>

		<style>
			@keyframes fadeIn {
				from {
					opacity: 0;
					transform: translateY(6px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			/* Active category pill */
			.active-cat {
				background-color: #111;
				color: #fff;
				border-color: #111;
			}

			.inactive-cat {
				background-color: transparent;
				color: inherit;
				border-color: oklch(var(--b3));
			}

			.inactive-cat:hover {
				background-color: oklch(var(--b3));
			}



			/* Post title hover color */
			.post-list-item:hover .post-title {
				color: oklch(var(--p));
			}

			/* Placeholder thumbnail bg */
			.placeholder-thumb {
				background: linear-gradient(135deg, oklch(var(--b3)), oklch(var(--b2)));
			}
		</style>
	</body>
</html>
