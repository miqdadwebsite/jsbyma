---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<BaseHead title={`Search - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-base-200">
		<Header />
		<main class="w-full max-w-[760px] mx-auto p-4 min-h-[calc(100vh-200px)]">
			<div class="mt-8 mb-12">
				<h1 class="text-3xl font-bold">Search Results for "<span id="search-query-display" class="text-primary"></span>"</h1>
			</div>

			<div id="search-results" class="divide-y divide-base-300">
				{
					posts.map((post) => (
						<a
							href={`/blog/${post.id}/`}
							class="post-list-item flex items-start gap-6 py-8 group no-underline hidden"
							data-search-card
							data-title={post.data.title.toLowerCase()}
							data-description={(post.data.description || "").toLowerCase()}
						>
							<!-- Left: Content -->
							<div class="flex-1 min-w-0">
								<!-- Author / Meta row -->
								<div class="flex items-center gap-2 mb-3">
									<span class="badge badge-ghost bg-base-300 badge-sm font-semibold">
										{post.data.category}
									</span>
								</div>

								<!-- Title -->
								<h2 class="post-title text-xl font-bold leading-snug mb-2 transition-colors duration-200">
									{post.data.title}
								</h2>

								<!-- Description -->
								<p class="text-sm opacity-60 leading-relaxed line-clamp-2 mb-4">
									{post.data.description ||
										"Read more about this topic in the full article."}
								</p>

								<!-- Footer meta -->
								<div
									class="flex items-center gap-4 text-xs opacity-50"
									data-lyket-id={post.data.title.replace(/\s+/g, "-").toLowerCase()}
								>
									<span>
										<FormattedDate date={post.data.pubDate} />
									</span>

									<span class="w-1 h-1 rounded-full bg-current inline-block" />
									<span class="like-count flex items-center gap-1">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3 h-3"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
										<span class="like-num">—</span>
									</span>
								</div>
							</div>

							<!-- Right: Thumbnail -->
							<div class="shrink-0 w-28 h-20 md:w-36 md:h-24 rounded-lg overflow-hidden bg-base-300">
								{post.data.heroImage ? (
									<Image
										width={288}
										height={192}
										src={post.data.heroImage}
										alt={post.data.title}
										class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
									/>
								) : (
									<div class="w-full h-full placeholder-thumb flex items-center justify-center text-2xl opacity-20">
										📄
									</div>
								)}
							</div>
						</a>
					))
				}
			</div>

			<div id="no-results" class="hidden text-center py-12">
				<p class="text-xl text-base-content/70">No posts found matching your search.</p>
				<a href="/blog" class="btn btn-primary mt-4">Browse all posts</a>
			</div>
		</main>
		<Footer />

		<script>
			const LYKET_API_KEY = "pt_866de2eda694caa5888541c1f7cfdb";

			async function loadLikeCounts() {
				const metaRows = document.querySelectorAll<HTMLElement>("[data-lyket-id]");
				const ids = Array.from(metaRows).map((el) => el.dataset.lyketId!);

				await Promise.all(
					ids.map(async (id, i) => {
						try {
							const res = await fetch(
								`https://api.lyket.dev/v1/like-buttons/blog-post/${id}`,
								{ headers: { Authorization: `Bearer ${LYKET_API_KEY}` } },
							);
							if (!res.ok) return;
							const json = await res.json();
							const count: number =
								json?.data?.attributes?.total_likes ?? 0;
							
							const metaRow = metaRows[i];
							if (metaRow) {
								const numEl = metaRow.querySelector(".like-num");
								if (numEl) numEl.textContent = String(count);
							}
						} catch (_) {
							// silently ignore network errors
						}
					}),
				);
			}

			// Runs on the client
			window.addEventListener('DOMContentLoaded', () => {
				const params = new URLSearchParams(window.location.search);
				const query = params.get('q')?.toLowerCase() || '';
				
				const queryDisplay = document.getElementById('search-query-display');
				if (queryDisplay) queryDisplay.textContent = params.get('q') || '';
				
				const cards = document.querySelectorAll<HTMLElement>('[data-search-card]');
				const noResults = document.getElementById('no-results');
				
				if (query && noResults) {
					let visibleCount = 0;
					
					cards.forEach(card => {
						const title = card.dataset.title || '';
						const desc = card.dataset.description || '';
						
						if (title.includes(query) || desc.includes(query)) {
							card.classList.remove('hidden');
							visibleCount++;
						} else {
							card.classList.add('hidden');
						}
					});
					
					if (visibleCount === 0) {
						noResults.classList.remove('hidden');
					} else {
						noResults.classList.add('hidden');
					}
				} else if (noResults && queryDisplay) {
					noResults.classList.remove('hidden');
					queryDisplay.textContent = "Please enter a search term.";
				}

				// Load like counts
				loadLikeCounts();
			});
		</script>
		<style>
			/* Post title hover color */
			.post-list-item:hover .post-title {
				color: oklch(var(--p));
			}

			/* Placeholder thumbnail bg */
			.placeholder-thumb {
				background: linear-gradient(135deg, oklch(var(--b3)), oklch(var(--b2)));
			}
		</style>
	</body>
</html>
