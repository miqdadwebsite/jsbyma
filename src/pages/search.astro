---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Search - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-base-200">
		<Header />
		<main class="w-full max-w-[960px] mx-auto p-4 min-h-[calc(100vh-200px)]">
			<div class="mt-8 mb-12">
				<h1 class="text-3xl font-bold">Search Results for "<span id="search-query-display" class="text-primary"></span>"</h1>
			</div>

			<div id="search-results" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					posts.map((post) => (
						<a
							href={`/blog/${post.id}/`}
							class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all hover:-translate-y-1 no-underline hidden"
							data-search-card
							data-title={post.data.title.toLowerCase()}
							data-description={(post.data.description || "").toLowerCase()}
						>
							<figure>
								{post.data.heroImage ? (
									<Image
										width={400}
										height={200}
										src={post.data.heroImage}
										alt={post.data.title}
										class="w-full h-48 object-cover"
									/>
								) : (
									<div class="w-full h-48 bg-neutral" />
								)}
							</figure>
							<div class="card-body">
								<div class="flex items-start justify-between gap-2">
									<h2 class="card-title text-base leading-snug">
										{post.data.title}
									</h2>
								</div>
								<div class="badge badge-primary badge-outline badge-sm w-fit">
									{post.data.category}
								</div>
								<p class="text-sm opacity-70 mt-1">
									{post.data.description ||
										'Read more about this topic in the full article.'}
								</p>
								<div class="card-actions justify-between items-center mt-4 w-full">
									<div 
										class="scale-90 origin-left"
										data-lyket-type="like" 
										data-lyket-id={post.data.title.replace(/\s+/g, "-").toLowerCase()} 
										data-lyket-namespace="blog-post"
									></div>
									<div class="badge badge-outline">
										<FormattedDate date={post.data.pubDate} />
									</div>
								</div>
							</div>
						</a>
					))
				}
			</div>

			<div id="no-results" class="hidden text-center py-12">
				<p class="text-xl text-base-content/70">No posts found matching your search.</p>
				<a href="/blog" class="btn btn-primary mt-4">Browse all posts</a>
			</div>
		</main>
		<Footer />

		<script>
			// Runs on the client
			window.addEventListener('DOMContentLoaded', () => {
				const params = new URLSearchParams(window.location.search);
				const query = params.get('q')?.toLowerCase() || '';
				
				const queryDisplay = document.getElementById('search-query-display');
				if (queryDisplay) queryDisplay.textContent = params.get('q') || '';
				
				const cards = document.querySelectorAll<HTMLElement>('[data-search-card]');
				const noResults = document.getElementById('no-results');
				
				if (query && noResults) {
					let visibleCount = 0;
					
					cards.forEach(card => {
						const title = card.dataset.title || '';
						const desc = card.dataset.description || '';
						
						if (title.includes(query) || desc.includes(query)) {
							card.classList.remove('hidden');
							visibleCount++;
						} else {
							card.classList.add('hidden');
						}
					});
					
					if (visibleCount === 0) {
						noResults.classList.remove('hidden');
					} else {
						noResults.classList.add('hidden');
					}
				} else if (noResults && queryDisplay) {
					noResults.classList.remove('hidden');
					queryDisplay.textContent = "Please enter a search term.";
				}
			});
		</script>
	</body>
</html>
