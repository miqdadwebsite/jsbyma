---
import { Image } from "astro:assets";

interface Props {
  screenshots: ImageMetadata[];
  title: string;
  id: string;
}

const { screenshots, title, id } = Astro.props;

if (!screenshots || screenshots.length === 0) {
  return;
}
---

<div class="screenshot-carousel" id={`carousel-${id}`} data-total={screenshots.length}>
  <!-- Heading -->
  <h2 class="carousel-heading">📸 Screenshots</h2>

  <!-- Main Slide Area -->
  <div class="carousel-stage">
    <!-- Slides -->
    <div class="slides-wrapper" id={`slides-${id}`}>
      {screenshots.map((img, i) => (
        <div
          class:list={["slide", i === 0 ? "slide--active" : ""]}
          data-index={i}
        >
          <button
            class="slide-btn"
            type="button"
            aria-label={`View ${title} screenshot ${i + 1} fullscreen`}
            data-lightbox-trigger={id}
            data-lightbox-index={i}
          >
            <Image
              src={img}
              alt={`${title} screenshot ${i + 1}`}
              width={900}
              height={506}
              class="slide-img"
              loading={i === 0 ? "eager" : "lazy"}
            />
          </button>
        </div>
      ))}
    </div>

    <!-- Prev/Next arrows -->
    {screenshots.length > 1 && (
      <>
        <button class="carousel-arrow carousel-arrow--prev" type="button" aria-label="Previous screenshot" data-carousel-prev={id}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="carousel-arrow carousel-arrow--next" type="button" aria-label="Next screenshot" data-carousel-next={id}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </>
    )}

    <!-- Counter badge -->
    <div class="carousel-counter">
      <span class="counter-current" data-counter={id}>1</span>
      <span class="counter-sep">/</span>
      <span class="counter-total">{screenshots.length}</span>
    </div>
  </div>

  <!-- Dot indicators -->
  {screenshots.length > 1 && (
    <div class="carousel-dots" aria-label="Slide indicators">
      {screenshots.map((_, i) => (
        <button
          class:list={["dot", i === 0 ? "dot--active" : ""]}
          type="button"
          aria-label={`Go to screenshot ${i + 1}`}
          data-carousel-dot={id}
          data-dot-index={i}
        />
      ))}
    </div>
  )}

  <!-- Thumbnail strip -->
  {screenshots.length > 1 && (
    <div class="thumbnail-strip" aria-label="Screenshot thumbnails">
      {screenshots.map((img, i) => (
        <button
          class:list={["thumb", i === 0 ? "thumb--active" : ""]}
          type="button"
          aria-label={`Screenshot ${i + 1}`}
          data-carousel-thumb={id}
          data-thumb-index={i}
        >
          <Image
            src={img}
            alt={`Thumbnail ${i + 1}`}
            width={160}
            height={90}
            class="thumb-img"
            loading="lazy"
          />
        </button>
      ))}
    </div>
  )}
</div>

<!-- Lightbox Modal -->
<div
  class="lightbox-overlay"
  id={`lightbox-${id}`}
  style="display:none;"
  data-lightbox-id={id}
  role="dialog"
  aria-modal="true"
  aria-label="Screenshot fullscreen view"
>
  <button class="lightbox-close-btn" type="button" aria-label="Close" data-lightbox-close={id}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>

  <button class="lightbox-nav lightbox-nav--prev" type="button" aria-label="Previous" data-lightbox-prev={id}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><polyline points="15 18 9 12 15 6"/></svg>
  </button>

  <div class="lightbox-img-wrap">
    <img
      id={`lightbox-img-${id}`}
      class="lightbox-img"
      src=""
      alt=""
    />
  </div>

  <button class="lightbox-nav lightbox-nav--next" type="button" aria-label="Next" data-lightbox-next={id}>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><polyline points="9 18 15 12 9 6"/></svg>
  </button>

  <div class="lightbox-counter-badge">
    <span data-lightbox-counter={id}>1</span> / {screenshots.length}
  </div>
</div>

<script define:vars={{ carouselId: id, totalSlides: screenshots.length, imageSrcs: screenshots.map(img => img.src) }}>
  (function() {
    let current = 0;

    const slidesWrapper = document.getElementById(`slides-${carouselId}`);
    const slides = slidesWrapper ? Array.from(slidesWrapper.querySelectorAll('.slide')) : [];
    const dots = Array.from(document.querySelectorAll(`[data-carousel-dot="${carouselId}"]`));
    const thumbs = Array.from(document.querySelectorAll(`[data-carousel-thumb="${carouselId}"]`));
    const counterEl = document.querySelector(`[data-counter="${carouselId}"]`);
    const lightbox = document.getElementById(`lightbox-${carouselId}`);
    const lightboxImg = document.getElementById(`lightbox-img-${carouselId}`);
    const lightboxCounter = document.querySelector(`[data-lightbox-counter="${carouselId}"]`);

    function goTo(index) {
      slides[current]?.classList.remove('slide--active');
      dots[current]?.classList.remove('dot--active');
      thumbs[current]?.classList.remove('thumb--active');

      current = (index + totalSlides) % totalSlides;

      slides[current]?.classList.add('slide--active');
      dots[current]?.classList.add('dot--active');
      thumbs[current]?.classList.add('thumb--active');

      if (counterEl) counterEl.textContent = (current + 1).toString();

      // Scroll thumb into view
      thumbs[current]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    // Prev/next carousel arrows
    document.querySelector(`[data-carousel-prev="${carouselId}"]`)?.addEventListener('click', () => goTo(current - 1));
    document.querySelector(`[data-carousel-next="${carouselId}"]`)?.addEventListener('click', () => goTo(current + 1));

    // Dot clicks
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Thumb clicks
    thumbs.forEach((thumb, i) => thumb.addEventListener('click', () => goTo(i)));

    // Lightbox open
    const triggers = document.querySelectorAll(`[data-lightbox-trigger="${carouselId}"]`);
    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const idx = parseInt(trigger.getAttribute('data-lightbox-index') || '0');
        openLightbox(idx);
      });
    });

    // Lightbox also opens on current slide trigger
    slides.forEach((slide, i) => {
      slide.querySelector('.slide-btn')?.addEventListener('click', () => openLightbox(i));
    });

    function openLightbox(idx) {
      if (!lightbox || !lightboxImg) return;
      current = (idx + totalSlides) % totalSlides;
      lightboxImg.src = imageSrcs[current];
      lightboxImg.alt = `Screenshot ${current + 1}`;
      if (lightboxCounter) lightboxCounter.textContent = (current + 1).toString();
      lightbox.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.style.display = 'none';
      document.body.style.overflow = '';
    }

    function lightboxGoTo(idx) {
      if (!lightboxImg) return;
      current = (idx + totalSlides) % totalSlides;
      lightboxImg.src = imageSrcs[current];
      lightboxImg.alt = `Screenshot ${current + 1}`;
      if (lightboxCounter) lightboxCounter.textContent = (current + 1).toString();
    }

    document.querySelector(`[data-lightbox-close="${carouselId}"]`)?.addEventListener('click', closeLightbox);
    document.querySelector(`[data-lightbox-prev="${carouselId}"]`)?.addEventListener('click', () => lightboxGoTo(current - 1));
    document.querySelector(`[data-lightbox-next="${carouselId}"]`)?.addEventListener('click', () => lightboxGoTo(current + 1));

    // Click backdrop to close
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!lightbox || lightbox.style.display !== 'flex') return;
      if (e.key === 'ArrowLeft') lightboxGoTo(current - 1);
      else if (e.key === 'ArrowRight') lightboxGoTo(current + 1);
      else if (e.key === 'Escape') closeLightbox();
    });

    // Touch/swipe support for carousel
    let touchStartX = 0;
    slidesWrapper?.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    slidesWrapper?.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
    }, { passive: true });

    // Touch/swipe for lightbox
    let lbTouchX = 0;
    lightbox?.addEventListener('touchstart', (e) => {
      lbTouchX = e.touches[0].clientX;
    }, { passive: true });
    lightbox?.addEventListener('touchend', (e) => {
      const diff = lbTouchX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) lightboxGoTo(diff > 0 ? current + 1 : current - 1);
    }, { passive: true });
  })();
</script>

<style>
  .screenshot-carousel {
    margin: 40px 0;
  }
  .carousel-heading {
    font-size: 22px;
    font-weight: 700;
    color: #242424;
    margin-bottom: 16px;
  }

  /* ── Stage ─────────────────────────────────────── */
  .carousel-stage {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    background: #0d0d0d;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    aspect-ratio: 16/9;
    cursor: pointer;
  }
  .slides-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .slide--active {
    opacity: 1;
    pointer-events: auto;
  }
  .slide-btn {
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: zoom-in;
    display: block;
  }
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .carousel-stage:hover .slide-img {
    transform: scale(1.015);
  }

  /* ── Arrows ─────────────────────────────────────── */
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0,0,0,0.55);
    color: #fff;
    border: 0;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s, transform 0.15s;
    backdrop-filter: blur(4px);
  }
  .carousel-arrow:hover {
    background: rgba(0,0,0,0.8);
    transform: translateY(-50%) scale(1.08);
  }
  .carousel-arrow--prev { left: 12px; }
  .carousel-arrow--next { right: 12px; }

  /* ── Counter ────────────────────────────────────── */
  .carousel-counter {
    position: absolute;
    bottom: 12px;
    right: 14px;
    background: rgba(0,0,0,0.6);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }
  .counter-sep { margin: 0 2px; opacity: 0.6; }

  /* ── Dots ───────────────────────────────────────── */
  .carousel-dots {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-top: 14px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d1d5db;
    border: 0;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }
  .dot--active {
    background: #6366f1;
    transform: scale(1.3);
  }

  /* ── Thumbnail strip ────────────────────────────── */
  .thumbnail-strip {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    overflow-x: auto;
    padding-bottom: 4px;
    scroll-behavior: smooth;
  }
  .thumbnail-strip::-webkit-scrollbar { height: 4px; }
  .thumbnail-strip::-webkit-scrollbar-track { background: transparent; }
  .thumbnail-strip::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 99px; }

  .thumb {
    flex-shrink: 0;
    width: 100px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    transition: border-color 0.2s, opacity 0.2s, transform 0.15s;
    padding: 0;
    background: transparent;
    opacity: 0.55;
  }
  .thumb:hover { opacity: 0.85; transform: scale(1.04); }
  .thumb--active {
    border-color: #6366f1;
    opacity: 1;
  }
  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Lightbox ───────────────────────────────────── */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: lb-fadein 0.25s ease;
  }
  @keyframes lb-fadein {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .lightbox-img-wrap {
    max-width: 92vw;
    max-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-img {
    max-width: 92vw;
    max-height: 88vh;
    width: auto;
    height: auto;
    border-radius: 10px;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    display: block;
  }
  .lightbox-close-btn {
    position: fixed;
    top: 18px;
    right: 20px;
    background: rgba(255,255,255,0.12);
    border: 0;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    backdrop-filter: blur(4px);
    z-index: 10;
  }
  .lightbox-close-btn:hover {
    background: rgba(255,255,255,0.25);
    transform: scale(1.08);
  }
  .lightbox-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.1);
    border: 0;
    border-radius: 50%;
    width: 52px;
    height: 52px;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    backdrop-filter: blur(4px);
    z-index: 10;
  }
  .lightbox-nav:hover {
    background: rgba(255,255,255,0.25);
    transform: translateY(-50%) scale(1.08);
  }
  .lightbox-nav--prev { left: 20px; }
  .lightbox-nav--next { right: 20px; }
  .lightbox-counter-badge {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255,255,255,0.12);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }
</style>