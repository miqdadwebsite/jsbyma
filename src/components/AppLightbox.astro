---
/**
 * AppLightbox.astro
 * Lightbox carousel untuk App detail page.
 * Menerima array ImageMetadata (dari Astro image()) dan ID unik.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  images: ImageMetadata[];
}

const { id, images } = Astro.props;
const hasMultiple = images.length > 1;
---

<!-- Lightbox Modal (hidden by default) -->
<div
  id={`lightbox-${id}`}
  class="lightbox-modal"
  data-lightbox-id={id}
  data-images={JSON.stringify(images.map((img) => img.src))}
  style="display:none"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
>
  <!-- Backdrop -->
  <div class="lightbox-backdrop" />

  <!-- Content -->
  <div class="lightbox-content">
    <!-- Close -->
    <button class="lightbox-close" type="button" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Image -->
    <img
      id={`lightbox-image-${id}`}
      src={images[0]?.src}
      alt="App screenshot"
      class="lightbox-img"
    />

    {hasMultiple && (
      <>
        <!-- Prev -->
        <button class="lightbox-prev" type="button" aria-label="Previous">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <!-- Next -->
        <button class="lightbox-next" type="button" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Counter -->
        <div class="lightbox-counter-wrap">
          <span class="lightbox-counter">1</span>
          <span class="opacity-60 mx-1">/</span>
          <span>{images.length}</span>
        </div>

        <!-- Dot indicators -->
        <div class="lightbox-dots">
          {images.map((_, i) => (
            <button
              class:list={["lightbox-dot", { "active": i === 0 }]}
              data-index={i}
              type="button"
              aria-label={`Go to image ${i + 1}`}
            />
          ))}
        </div>
      </>
    )}
  </div>
</div>

<!-- Thumbnail strip (inline on page) — hidden if only 1 image -->
{hasMultiple && (
  <div class="lightbox-thumbs" id={`thumbs-${id}`}>
    {images.map((img, i) => (
      <button
        class:list={["thumb-btn", { "thumb-active": i === 0 }]}
        data-lightbox-id={id}
        data-image-index={i}
        type="button"
        aria-label={`View screenshot ${i + 1}`}
      >
        <Image
          src={img}
          width={120}
          height={80}
          alt={`Screenshot ${i + 1}`}
          class="thumb-img"
        />
      </button>
    ))}
  </div>
)}

<script>
  function initLightbox() {
    // Triggers: hero button + thumbnail buttons
    const triggers = document.querySelectorAll<HTMLElement>("[data-lightbox-id]");
    const modals = document.querySelectorAll<HTMLElement>(".lightbox-modal");

    // State
    const state = new Map<string, number>();

    function getImages(lightboxId: string): string[] {
      const modal = document.getElementById(`lightbox-${lightboxId}`);
      return JSON.parse(modal?.getAttribute("data-images") || "[]");
    }

    function updateModal(lightboxId: string, index: number) {
      const modal = document.getElementById(`lightbox-${lightboxId}`);
      if (!modal) return;
      const images = getImages(lightboxId);

      // Update main image
      const img = modal.querySelector<HTMLImageElement>(`#lightbox-image-${lightboxId}`);
      if (img && images[index]) img.src = images[index];

      // Update counter
      const counter = modal.querySelector(".lightbox-counter");
      if (counter) counter.textContent = (index + 1).toString();

      // Update dots
      modal.querySelectorAll(".lightbox-dot").forEach((dot, i) => {
        dot.classList.toggle("active", i === index);
      });

      // Update thumbnail active state (outside modal)
      const thumbsWrap = document.getElementById(`thumbs-${lightboxId}`);
      thumbsWrap?.querySelectorAll<HTMLElement>(".thumb-btn").forEach((btn, i) => {
        btn.classList.toggle("thumb-active", i === index);
      });

      state.set(lightboxId, index);
    }

    function openModal(lightboxId: string, index: number) {
      const modal = document.getElementById(`lightbox-${lightboxId}`);
      if (!modal) return;
      updateModal(lightboxId, index);
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
    }

    function closeModal(lightboxId: string) {
      const modal = document.getElementById(`lightbox-${lightboxId}`);
      if (modal) modal.style.display = "none";
      document.body.style.overflow = "";
    }

    // Attach open triggers (hero + thumbnails)
    triggers.forEach((el) => {
      // Skip the modal itself and its inner elements
      if (el.classList.contains("lightbox-modal")) return;
      if (el.classList.contains("lightbox-close") || el.classList.contains("lightbox-prev") || el.classList.contains("lightbox-next") || el.classList.contains("lightbox-dot")) return;

      el.addEventListener("click", (e) => {
        e.preventDefault();
        const id = el.dataset.lightboxId!;
        const index = parseInt(el.dataset.imageIndex || "0");
        openModal(id, index);
      });
    });

    // Close button
    document.querySelectorAll(".lightbox-close").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const modal = (btn as HTMLElement).closest<HTMLElement>(".lightbox-modal");
        const id = modal?.dataset.lightboxId;
        if (id) closeModal(id);
      });
    });

    // Backdrop click
    modals.forEach((modal) => {
      modal.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        if (!target.closest(".lightbox-content")) {
          const id = modal.dataset.lightboxId;
          if (id) closeModal(id);
        }
      });
    });

    // Prev / Next
    document.querySelectorAll(".lightbox-prev").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const modal = (btn as HTMLElement).closest<HTMLElement>(".lightbox-modal");
        const id = modal?.dataset.lightboxId;
        if (!id) return;
        const images = getImages(id);
        const cur = state.get(id) || 0;
        updateModal(id, (cur - 1 + images.length) % images.length);
      });
    });

    document.querySelectorAll(".lightbox-next").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const modal = (btn as HTMLElement).closest<HTMLElement>(".lightbox-modal");
        const id = modal?.dataset.lightboxId;
        if (!id) return;
        const images = getImages(id);
        const cur = state.get(id) || 0;
        updateModal(id, (cur + 1) % images.length);
      });
    });

    // Dot clicks
    document.querySelectorAll(".lightbox-dot").forEach((dot) => {
      dot.addEventListener("click", (e) => {
        e.stopPropagation();
        const modal = (dot as HTMLElement).closest<HTMLElement>(".lightbox-modal");
        const id = modal?.dataset.lightboxId;
        const index = parseInt((dot as HTMLElement).dataset.index || "0");
        if (id) updateModal(id, index);
      });
    });

    // Keyboard
    document.addEventListener("keydown", (e) => {
      const visible = document.querySelector<HTMLElement>('.lightbox-modal[style*="flex"]');
      if (!visible) return;
      const id = visible.dataset.lightboxId;
      if (!id) return;
      const images = getImages(id);
      const cur = state.get(id) || 0;

      if (e.key === "ArrowLeft") { e.preventDefault(); updateModal(id, (cur - 1 + images.length) % images.length); }
      else if (e.key === "ArrowRight") { e.preventDefault(); updateModal(id, (cur + 1) % images.length); }
      else if (e.key === "Escape") closeModal(id);
    });

    // Swipe / Touch
    modals.forEach((modal) => {
      let startX = 0;
      modal.addEventListener("touchstart", (e) => { startX = (e as TouchEvent).touches[0].clientX; }, { passive: true });
      modal.addEventListener("touchend", (e) => {
        const endX = (e as TouchEvent).changedTouches[0].clientX;
        const diff = startX - endX;
        if (Math.abs(diff) < 50) return;
        const id = modal.dataset.lightboxId;
        if (!id) return;
        const images = getImages(id);
        if (images.length <= 1) return;
        const cur = state.get(id) || 0;
        updateModal(id, diff > 0 ? (cur + 1) % images.length : (cur - 1 + images.length) % images.length);
      }, { passive: true });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLightbox);
  } else {
    initLightbox();
  }
  document.addEventListener("astro:after-swap", initLightbox);
</script>

<style>
  /* ─── Modal ─────────────────────────────────────── */
  .lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: lbFadeIn 0.2s ease;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(6px);
  }

  .lightbox-content {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 60px 24px 80px;
  }

  /* ─── Main image ─────────────────────────────────── */
  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    transition: opacity 0.15s ease;
    display: block;
  }

  /* ─── Controls ───────────────────────────────────── */
  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: rgba(255,255,255,0.1);
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    z-index: 2;
  }
  .lightbox-close:hover { background: rgba(255,255,255,0.25); }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.1);
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    z-index: 2;
  }
  .lightbox-prev { left: 16px; }
  .lightbox-next { right: 16px; }
  .lightbox-prev:hover,
  .lightbox-next:hover { background: rgba(255,255,255,0.25); }

  /* ─── Counter ────────────────────────────────────── */
  .lightbox-counter-wrap {
    position: absolute;
    top: 18px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.5);
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    z-index: 2;
  }

  /* ─── Dots ───────────────────────────────────────── */
  .lightbox-dots {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }
  .lightbox-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.35);
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }
  .lightbox-dot.active {
    background: #fff;
    transform: scale(1.25);
  }

  /* ─── Thumbnail Strip ────────────────────────────── */
  .lightbox-thumbs {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  .thumb-btn {
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: none;
    transition: border-color 0.2s, opacity 0.2s;
    opacity: 0.65;
    flex-shrink: 0;
    width: 80px;
    height: 56px;
  }
  .thumb-btn:hover { opacity: 1; }
  .thumb-btn.thumb-active {
    border-color: #6366f1;
    opacity: 1;
  }
  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @keyframes lbFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 640px) {
    .lightbox-prev { left: 8px; }
    .lightbox-next { right: 8px; }
    .lightbox-prev,
    .lightbox-next { width: 40px; height: 40px; }
    .thumb-btn { width: 64px; height: 44px; }
  }
</style>
