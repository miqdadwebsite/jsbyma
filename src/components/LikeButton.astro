---
interface Props {
	id: string;
	variant?: "header" | "footer";
}

const { id, variant = "footer" } = Astro.props;
---

<button
	type="button"
	class:list={["like-button", variant]}
	data-like-id={id}
	aria-pressed="false"
	aria-label="Suka artikel ini"
>
	<span class="like-icon" aria-hidden="true">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
			<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
		</svg>
	</span>
	<span class="like-count" data-like-count>—</span>
</button>

<script>
	import { formatLikes, subscribeLike, toggleLike } from "../lib/likes";

	// Wires every like button rendered on the page (header + footer can share
	// the same post id and are kept in sync via the module-level store).
	document.querySelectorAll<HTMLButtonElement>("[data-like-id]").forEach((btn) => {
		const id = btn.dataset.likeId!;
		const countEl = btn.querySelector<HTMLElement>("[data-like-count]");

		const render = (s: { likes: number; liked: boolean }) => {
			if (countEl) countEl.textContent = formatLikes(s.likes);
			btn.classList.toggle("is-liked", s.liked);
			btn.setAttribute("aria-pressed", String(s.liked));
			btn.setAttribute(
				"aria-label",
				s.liked ? "Batalkan suka untuk artikel ini" : "Suka artikel ini",
			);
		};

		subscribeLike(id, render);

		btn.addEventListener("click", () => {
			toggleLike(id).catch(() => {
				// Revert is handled in the shared module on failure.
			});
		});
	});
</script>

<style>
	.like-button {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		border: none;
		cursor: pointer;
		background: transparent;
		padding: 0;
		font-family: 'Poppins', sans-serif;
		color: #6b6b6b;
		transition: color 0.2s ease, border-color 0.2s ease, transform 0.1s ease;
	}

	.like-button:active {
		transform: scale(0.92);
	}

	.like-icon {
		display: inline-flex;
		flex-shrink: 0;
	}

	.like-icon svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linejoin: round;
		transition: fill 0.2s ease, stroke 0.2s ease;
	}

	.like-count {
		min-width: 2ch;
		text-align: left;
		font-variant-numeric: tabular-nums;
	}

	/* ─── Variants ─────────────────────────────────── */

	.like-button.header {
		font-size: 13px;
		font-weight: 500;
	}

	.like-button.header .like-icon {
		width: 17px;
		height: 17px;
	}

	.like-button.footer {
		font-size: 15px;
		font-weight: 500;
		padding: 10px 18px;
		border: 1px solid #e4e4e4;
		border-radius: 999px;
		background: #fff;
	}

	.like-button.footer .like-icon {
		width: 18px;
		height: 18px;
	}

	.like-button.footer:hover {
		color: #1a8917;
		border-color: #1a8917;
	}

	/* ─── Liked state ──────────────────────────────── */

	.like-button.is-liked {
		color: #1a8917;
	}

	.like-button.is-liked .like-icon svg {
		fill: currentColor;
		stroke: none;
	}

	.like-button.footer.is-liked {
		border-color: #1a8917;
		background: #f0faf0;
	}
</style>